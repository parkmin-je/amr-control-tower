# AMR Control Tower — 환경변수 설정 예시
# 이 파일을 복사해 .env 로 만든 후 실제 값으로 교체하세요.
# .env 는 .gitignore에 포함되어 있어 Git에 커밋되지 않습니다.
#
#   cp .env.example .env

# ── MySQL ─────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=amr
MYSQL_PASSWORD=change_me_amr_password

# ── Grafana ───────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password

# ── ROS Bridge (로봇 WebSocket 주소) ─────────────────────────────────
# Ubuntu VM 또는 실제 로봇 머신의 IP:port
ROSBRIDGE_ROBOT_01_URI=ws://192.168.109.130:9090

# ── HTTPS / Let's Encrypt ─────────────────────────────────────────
# 실제 소유한 도메인으로 교체하세요.
# 인증서 최초 발급: docker-compose run --rm certbot certonly --webroot ...
DOMAIN=your-domain.com
CERTBOT_EMAIL=your-email@example.com

# ── Slack Webhook (선택사항 — 비워두면 알림 비활성화) ─────────────────
SLACK_WEBHOOK_URL=
