# ── rosbridge 연결 설정 ─────────────────────────────────────────────
# Ubuntu VM 또는 실제 로봇 머신의 IP:port
ROSBRIDGE_ROBOT_01_URI=ws://192.168.109.130:9090

# 로봇 추가 시 아래 형식으로 application.yml에 항목 추가 후 설정
# ROSBRIDGE_ROBOT_02_URI=ws://192.168.109.131:9090

# ── MySQL 자격증명 ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=amrroot
MYSQL_USER=amr
MYSQL_PASSWORD=amrpass

# ── Grafana 관리자 비밀번호 ─────────────────────────────────────────
GRAFANA_PASSWORD=admin
